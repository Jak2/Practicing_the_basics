# Central control switch. Copy to `.env` and edit. Anything set here overrides config.yaml.

# --- Which folder to answer questions from ---
RAG_CORPUS_DIR=/absolute/path/to/your/documents

# --- Engine switches (override config.yaml; leave unset to use config.yaml) ---
# Default is fully local: Ollama + qwen2.5:1.5b, no API key required.
# RAG_LLM=ollama              # ollama | claude
# RAG_OLLAMA_MODEL=qwen2.5:1.5b   # any model you've pulled with `ollama pull`
# RAG_EMBED=local             # local
# RAG_STORE=chroma            # chroma
# RAG_RETRIEVAL=plain         # plain

# --- Only needed if you switch RAG_LLM=claude ---
# ANTHROPIC_API_KEY=

# --- Server ---
RAG_HOST=127.0.0.1
RAG_PORT=8000

# --- Storage (relative to project root) ---
# RAG_HISTORY_DB=.rag_history.sqlite
