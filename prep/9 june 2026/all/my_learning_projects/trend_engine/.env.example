# Copy this file to .env and fill in your keys. .env is gitignored — never commit it.

# Optional — youtube collector skips itself (logs a line, returns no items) if unset.
YOUTUBE_API_KEY=

# Optional — without it, every run falls back to degraded mode (math-only rankings,
# no dedup, no explanations, empty platform briefs).
ANTHROPIC_API_KEY=
