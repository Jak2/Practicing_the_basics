target_repo: /path/to/your/site          # absolute path to any local git repo

content_paths:
  prompts: content/prompts               # relative to target_repo
  workflows: content/workflows
  images: public/images

llm:
  provider: google                       # google | openai | anthropic
  model: gemini-2.0-flash
  image_model: imagen-3.0-generate-001

sources:
  tavily: true
  reddit:
    enabled: true
    subreddits:
      - MachineLearning
      - artificial
      - ChatGPT
      - GenZ
      - photography
  hackernews:
    enabled: true

dashboard:
  port: 8000
